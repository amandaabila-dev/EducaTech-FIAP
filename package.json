{
  "name": "educatech-fiap",
  "version": "4.0.0",
  "description": "EducaTech FIAP — API REST, front-end React e app React Native",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --coverage --runInBand",
    "test:unit": "jest --testPathIgnorePatterns=\"postRoutes.test|uiFlowRoutes.test|teacherRoutes.test|studentRoutes.test\" --coverage --runInBand",
    "test:integration": "jest postRoutes.test.js uiFlowRoutes.test.js teacherRoutes.test.js studentRoutes.test.js --runInBand",
    "test:watch": "jest --watch --runInBand",
    "test:docker": "docker compose --profile test run --rm test",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "frontend:install": "npm install --prefix frontend",
    "frontend:dev": "npm run dev --prefix frontend",
    "frontend:build": "npm run build --prefix frontend",
    "mobile:start": "npm start --prefix mobile"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}

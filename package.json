{
  "name": "educatech-fiap",
  "version": "3.0.0",
  "description": "EducaTech FIAP - API REST de blogging educacional (back-end da Fase 2) + front-end React (Fase 3)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --coverage --runInBand",
    "test:unit": "jest --testPathIgnorePatterns=\"postRoutes.test|uiFlowRoutes.test\" --coverage --runInBand",
    "test:integration": "jest postRoutes.test.js uiFlowRoutes.test.js --runInBand",
    "test:watch": "jest --watch --runInBand",
    "test:docker": "docker compose --profile test run --rm test",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "frontend:install": "npm install --prefix frontend",
    "frontend:dev": "npm run dev --prefix frontend",
    "frontend:build": "npm run build --prefix frontend"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}

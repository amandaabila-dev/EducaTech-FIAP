# Dependências instaladas pelo npm (recriadas com npm install)
node_modules/

# Relatório de cobertura gerado pelo Jest (recriado com npm test)
coverage/

# Build do front-end gerado pelo Vite (recriado com npm run build)
frontend/dist/

# Arquivos locais do desenvolvedor (pasta local/)
local/

# Variáveis de ambiente com credenciais reais
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# IDEs e editores
.vscode/
.idea/
.cursor/
*.swp
*.swo

# Cache e temporários
.nyc_output/
*.tmp
*.temp
